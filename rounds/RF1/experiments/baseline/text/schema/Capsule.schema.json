{
  "$defs": {
    "Author": {
      "description": "Who produced an item.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "A person.",
          "properties": {
            "kind": {
              "const": "human",
              "type": "string"
            },
            "name": {
              "description": "Display name or user id.",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "name"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "An AI agent.",
          "properties": {
            "kind": {
              "const": "agent",
              "type": "string"
            },
            "model": {
              "description": "Model identifier, if known.",
              "type": [
                "string",
                "null"
              ]
            },
            "name": {
              "description": "Agent name.",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "name"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "The deterministic engine.",
          "properties": {
            "kind": {
              "const": "engine",
              "type": "string"
            },
            "name": {
              "description": "Engine component name.",
              "type": "string"
            },
            "version": {
              "description": "Engine version.",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "name",
            "version"
          ],
          "type": "object"
        }
      ]
    },
    "CapsuleState": {
      "description": "Lifecycle state of a capsule:\n`draft -> live -> (updated)* -> invalidated | expired | approved | rejected`.",
      "oneOf": [
        {
          "const": "draft",
          "description": "Not yet shown as live.",
          "type": "string"
        },
        {
          "const": "live",
          "description": "Updates itself as its series change.",
          "type": "string"
        },
        {
          "const": "invalidated",
          "description": "The invalidation condition happened.",
          "type": "string"
        },
        {
          "const": "expired",
          "description": "Validity window elapsed.",
          "type": "string"
        },
        {
          "const": "approved",
          "description": "A person approved it.",
          "type": "string"
        },
        {
          "const": "rejected",
          "description": "A person rejected it.",
          "type": "string"
        }
      ]
    },
    "CompareOp": {
      "description": "Comparison operator used in conditions.",
      "oneOf": [
        {
          "const": "lt",
          "description": "Strictly less than.",
          "type": "string"
        },
        {
          "const": "le",
          "description": "Less than or equal.",
          "type": "string"
        },
        {
          "const": "gt",
          "description": "Strictly greater than.",
          "type": "string"
        },
        {
          "const": "ge",
          "description": "Greater than or equal.",
          "type": "string"
        },
        {
          "const": "cross_above",
          "description": "Crosses the value upwards.",
          "type": "string"
        },
        {
          "const": "cross_below",
          "description": "Crosses the value downwards.",
          "type": "string"
        }
      ]
    },
    "Depth": {
      "description": "Semantic zoom level: 0 sentence, 1 capsule, 2 marked chart, 3 full workspace.",
      "oneOf": [
        {
          "const": "sentence",
          "description": "Depth 0: one sentence.",
          "type": "string"
        },
        {
          "const": "capsule",
          "description": "Depth 1: the capsule.",
          "type": "string"
        },
        {
          "const": "chart",
          "description": "Depth 2: chart with marks.",
          "type": "string"
        },
        {
          "const": "workspace",
          "description": "Depth 3: full workspace.",
          "type": "string"
        }
      ]
    },
    "Direction": {
      "description": "Direction of a meaning.",
      "oneOf": [
        {
          "const": "up",
          "description": "Upwards.",
          "type": "string"
        },
        {
          "const": "down",
          "description": "Downwards.",
          "type": "string"
        },
        {
          "const": "neutral",
          "description": "No direction (e.g. a squeeze).",
          "type": "string"
        }
      ]
    },
    "EvidenceFamily": {
      "description": "Evidence family (K30). Several facts from one family count as one confirmation.",
      "oneOf": [
        {
          "const": "price",
          "description": "Price and indicators computed from price.",
          "type": "string"
        },
        {
          "const": "volume",
          "description": "Traded volume.",
          "type": "string"
        },
        {
          "const": "flow",
          "description": "Money flow: settlement, institutional (broker) flow.",
          "type": "string"
        },
        {
          "const": "derivative",
          "description": "Derivatives (futures, options).",
          "type": "string"
        },
        {
          "const": "news",
          "description": "News and fundamentals.",
          "type": "string"
        }
      ]
    },
    "Glyph": {
      "additionalProperties": false,
      "description": "A one-glance visual of meaning, not data.",
      "properties": {
        "kind": {
          "$ref": "#/$defs/GlyphKind",
          "description": "Which glyph."
        },
        "value": {
          "description": "Normalized magnitude; `[-1, 1]` for direction, `[0, 1]` otherwise.",
          "format": "double",
          "maximum": 1.0,
          "minimum": -1.0,
          "type": "number"
        }
      },
      "required": [
        "kind",
        "value"
      ],
      "type": "object"
    },
    "GlyphKind": {
      "description": "Kind of meaning glyph (initial candidate set; finalized in R3).",
      "oneOf": [
        {
          "const": "direction",
          "description": "Where is it going?",
          "type": "string"
        },
        {
          "const": "strength",
          "description": "How strong is the move?",
          "type": "string"
        },
        {
          "const": "uncertainty",
          "description": "How sure are we?",
          "type": "string"
        },
        {
          "const": "extremity",
          "description": "Is it unusual?",
          "type": "string"
        },
        {
          "const": "similarity",
          "description": "Has it happened before, and what followed?",
          "type": "string"
        },
        {
          "const": "change",
          "description": "What changed since the last look?",
          "type": "string"
        }
      ]
    },
    "LedgerStat": {
      "additionalProperties": false,
      "description": "Ledger statistic for one key (meaning kind + detector), as seen at some time.",
      "properties": {
        "n": {
          "description": "Closed capsules counted (realized + invalidated + expired; never retracted).",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "realized": {
          "description": "Of which realized.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "n",
        "realized"
      ],
      "type": "object"
    },
    "MeaningCondition": {
      "additionalProperties": false,
      "description": "A machine-checkable condition attached to a meaning (sentence slot).\n\n(R4, K42/A28) The same shape serves two different roles, which a story keeps in two\nseparate fields ([`Story::condition`], [`Story::resolution`]):\n\n- **state condition** (durum koşulu): whether the claim still holds **now** (\"RSI is\n  above 70\", \"the close is still above the broken level\"); it decides the capsule's\n  [`Validity`];\n- **expected resolution** (beklenen çözüm): how the story is expected to close (\"a\n  close outside the band within 20 bars\"); a state may have ended while the story is\n  still open.\n\nOn a fact ([`FactMeaning::condition`]) the role follows from the time kind\n(`qp_capsule::sentence::split_condition`): a state's condition with `within_bars` is\nits expected resolution, an expectation's condition is what resolves it, and every\nother condition is a state condition.",
      "properties": {
        "key": {
          "description": "Evidence key of the threshold value.",
          "type": "string"
        },
        "op": {
          "$ref": "#/$defs/CompareOp",
          "description": "Comparison."
        },
        "subject": {
          "description": "What is compared: `close`, `rsi`, `bandwidth`, … (detector-defined name).",
          "type": "string"
        },
        "within_bars": {
          "description": "Within how many bars (expectation), if bounded.",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "subject",
        "op",
        "key"
      ],
      "type": "object"
    },
    "MeaningKind": {
      "description": "The six meaning kinds (K30). The glyph's shape encodes this.",
      "oneOf": [
        {
          "const": "continuation",
          "description": "Devam: the move goes on (trend, MA alignment, flag).",
          "type": "string"
        },
        {
          "const": "reversal",
          "description": "Dönüş: the move may be turning (divergence, double top/bottom).",
          "type": "string"
        },
        {
          "const": "breakout",
          "description": "Kırılım: a boundary was crossed (range, channel, support/resistance).",
          "type": "string"
        },
        {
          "const": "squeeze",
          "description": "Sıkışma: the move is narrowing; direction unknown (band squeeze, low volatility).",
          "type": "string"
        },
        {
          "const": "extreme",
          "description": "Aşırılık: unusual stretch (overbought/oversold, outside the band).",
          "type": "string"
        },
        {
          "const": "flow",
          "description": "Akış: money in/out independent of price (volume, settlement, institutional flow).",
          "type": "string"
        }
      ]
    },
    "Provenance": {
      "additionalProperties": false,
      "description": "Who produced an item, based on what, and when.",
      "properties": {
        "approved_by": {
          "anyOf": [
            {
              "$ref": "#/$defs/Author"
            },
            {
              "type": "null"
            }
          ],
          "description": "Who approved it, when it entered the document through an accepted proposal\n(protocol: `accept_proposal`). Absent for direct writes."
        },
        "at": {
          "description": "Production time, epoch milliseconds UTC.",
          "format": "int64",
          "type": "integer"
        },
        "author": {
          "$ref": "#/$defs/Author",
          "description": "Producer."
        },
        "based_on": {
          "default": [],
          "description": "Ids of the items this one is based on.",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "author",
        "at"
      ],
      "type": "object"
    },
    "Resolution": {
      "additionalProperties": false,
      "description": "How a story is expected to close (R4, K42/A28: the **expected resolution**, kept apart\nfrom the state condition).",
      "properties": {
        "condition": {
          "anyOf": [
            {
              "$ref": "#/$defs/MeaningCondition"
            },
            {
              "type": "null"
            }
          ],
          "description": "The resolution the detector names, if any (a squeeze: \"a close outside the band\nwithin 20 bars\"; an expectation: its condition)."
        },
        "rule": {
          "description": "The outcome rule that closes the story (`barrier`: the per-kind volatility\nbarrier, M5); its natural life is [`Story::horizon_bars`].",
          "type": "string"
        }
      },
      "required": [
        "rule"
      ],
      "type": "object"
    },
    "Stage": {
      "description": "Lifecycle stage of a capsule story (K28, K37):\n`candidate → born → strengthened | weakened → confirmed → realized | invalidated |\nexpired | retracted`.",
      "oneOf": [
        {
          "const": "candidate",
          "description": "Aday: seen on an open bar; only on the watching replica; never in the authority's\nlog or the ledger.",
          "type": "string"
        },
        {
          "const": "born",
          "description": "Doğdu: finalized on bar close; the authority gave it an id.",
          "type": "string"
        },
        {
          "const": "strengthened",
          "description": "Güçlendi: a new supporting fact of the same family.",
          "type": "string"
        },
        {
          "const": "weakened",
          "description": "Zayıfladı: a fact against it, or its state weakened.",
          "type": "string"
        },
        {
          "const": "confirmed",
          "description": "Teyit edildi: a second (or further) independent evidence family supports it.",
          "type": "string"
        },
        {
          "const": "realized",
          "description": "Gerçekleşti: the outcome rule says it came true. Closes; ledger hit.",
          "type": "string"
        },
        {
          "const": "invalidated",
          "description": "Geçersiz: its invalidation happened. Closes; ledger miss.",
          "type": "string"
        },
        {
          "const": "expired",
          "description": "Süresi doldu: its natural life (in bars) ended without an outcome. Closes; ledger miss.",
          "type": "string"
        },
        {
          "const": "retracted",
          "description": "Geri çekildi: the data it rested on proved wrong (K37). Closes; NOT in the ledger.",
          "type": "string"
        }
      ]
    },
    "Story": {
      "additionalProperties": false,
      "description": "The story a capsule tells (R3). Optional on [`crate::Capsule`].",
      "properties": {
        "born_bar": {
          "description": "Bar the story was born on.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "condition": {
          "anyOf": [
            {
              "$ref": "#/$defs/MeaningCondition"
            },
            {
              "type": "null"
            }
          ],
          "description": "(R4, K42/A28) The **state condition**: whether the claim still holds now (from the\nfact that gave birth). Absent when the claim has none (a squeeze's band, an\nexpectation) and on stories written before R4."
        },
        "direction": {
          "$ref": "#/$defs/Direction",
          "description": "Direction."
        },
        "families": {
          "description": "Independent evidence families that support it (sorted, unique).",
          "items": {
            "$ref": "#/$defs/EvidenceFamily"
          },
          "type": "array"
        },
        "history": {
          "description": "Transitions, in order.",
          "items": {
            "$ref": "#/$defs/Transition"
          },
          "type": "array"
        },
        "horizon_bars": {
          "description": "Natural life in bars from birth (expiry by bar count, never by clock).",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "importance": {
          "description": "Importance score from the ranking rule (higher = more important).",
          "format": "double",
          "type": "number"
        },
        "instrument": {
          "description": "Instrument symbol.",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/MeaningKind",
          "description": "Meaning kind."
        },
        "last_bar": {
          "description": "Bar of the last transition.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "ledger_at_birth": {
          "$ref": "#/$defs/LedgerStat",
          "description": "Ledger at birth: only capsules closed before the birth bar (no look-ahead)."
        },
        "ledger_key": {
          "description": "Ledger key (`kind/direction/detector@version`; R4, K42/A23: up, down and neutral\nstories of one detector are counted apart).",
          "type": "string"
        },
        "resolution": {
          "anyOf": [
            {
              "$ref": "#/$defs/Resolution"
            },
            {
              "type": "null"
            }
          ],
          "description": "(R4, K42/A28) The **expected resolution**: how the story is expected to close.\nAbsent on stories written before R4."
        },
        "series": {
          "description": "The bar series the story lives on.",
          "type": "string"
        },
        "stage": {
          "$ref": "#/$defs/Stage",
          "description": "Current stage."
        },
        "strength": {
          "description": "Strength in `[0, 1]`.",
          "format": "double",
          "type": "number"
        },
        "theme": {
          "description": "Theme key: same instrument + same theme → one story (K28).",
          "type": "string"
        },
        "tier": {
          "description": "Importance tier: 1 most important … 3 least (sensitivity filters on it).",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        },
        "time": {
          "$ref": "#/$defs/TimeKind",
          "description": "Time kind."
        },
        "trust": {
          "$ref": "#/$defs/Trust",
          "description": "Trust path."
        }
      },
      "required": [
        "instrument",
        "theme",
        "kind",
        "direction",
        "time",
        "stage",
        "families",
        "strength",
        "importance",
        "tier",
        "series",
        "born_bar",
        "last_bar",
        "horizon_bars",
        "ledger_key",
        "ledger_at_birth",
        "trust",
        "history"
      ],
      "type": "object"
    },
    "TimeKind": {
      "description": "The three time kinds of a capsule (K27).",
      "oneOf": [
        {
          "const": "event",
          "description": "Olay: happened at a bar; past tense with its time; freshness fades.",
          "type": "string"
        },
        {
          "const": "state",
          "description": "Durum: holds while the condition holds; present tense; ends when it breaks.",
          "type": "string"
        },
        {
          "const": "expectation",
          "description": "Beklenti: conditional; lives until the condition is met or voided.",
          "type": "string"
        }
      ]
    },
    "Transition": {
      "additionalProperties": false,
      "description": "One transition in a capsule's story.",
      "properties": {
        "bar": {
          "description": "Bar index (of the story's bar series) at which it happened.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "facts": {
          "description": "Facts that caused it.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "reason": {
          "description": "Machine-readable reason (`new_family`, `same_family`, `opposite_fact`,\n`state_ended`, `outcome_hit`, `outcome_miss`, `horizon`, `data_corrected`,\n`dispute_upheld`, …).",
          "type": "string"
        },
        "stage": {
          "$ref": "#/$defs/Stage",
          "description": "Stage entered."
        },
        "t": {
          "description": "Bar time.",
          "format": "int64",
          "type": "integer"
        }
      },
      "required": [
        "stage",
        "bar",
        "t",
        "reason"
      ],
      "type": "object"
    },
    "Trust": {
      "description": "How a capsule reached the user; drives the \"verified by\" mark (K38).",
      "oneOf": [
        {
          "const": "replica",
          "description": "The replica can re-check it on its own data (consistency rule, §19).",
          "type": "string"
        },
        {
          "const": "server",
          "description": "Server fact: the replica cannot re-check it (licensed data); shown as verified\nby the server.",
          "type": "string"
        }
      ]
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "The live, openable, portable presentation of a single finding.",
  "properties": {
    "depth": {
      "$ref": "#/$defs/Depth",
      "description": "Depth the capsule is shown at by default."
    },
    "expires_at": {
      "description": "Expiry time, epoch milliseconds UTC.",
      "format": "int64",
      "type": [
        "integer",
        "null"
      ]
    },
    "finding": {
      "description": "Id of the finding it presents.",
      "type": "string"
    },
    "glyphs": {
      "default": [],
      "description": "Glyphs shown at a glance.",
      "items": {
        "$ref": "#/$defs/Glyph"
      },
      "type": "array"
    },
    "headline": {
      "description": "Depth-0 sentence.",
      "type": "string"
    },
    "id": {
      "description": "Unique id within the document.",
      "type": "string"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance",
      "description": "Who made it and when."
    },
    "revision": {
      "default": 0,
      "description": "Number of live updates so far.",
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "state": {
      "$ref": "#/$defs/CapsuleState",
      "description": "Lifecycle state."
    },
    "story": {
      "anyOf": [
        {
          "$ref": "#/$defs/Story"
        },
        {
          "type": "null"
        }
      ],
      "description": "The story (R3): theme, stage, families, ledger at birth, history. Absent on\ncapsules written before R3."
    },
    "view": {
      "description": "Id of the view used when the capsule is opened.",
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "id",
    "finding",
    "state",
    "headline",
    "depth",
    "provenance"
  ],
  "title": "Capsule",
  "type": "object"
}
