{
 "name": "34-entitlement-anchor-gap",
 "description": "RP2 T4 audit fixes: a condition on bound data (finding invalidation, intent trigger, condition subscription) needs the writer's data entitlement (§18.3, Y1); the anchor stamp cannot be undone (Y2) but one's own put_series can, through its stamp (O2); a seq gap makes the binding stale and is a host notice, not a connection output (§18.4, O1).",
 "covers": [
  "data"
 ],
 "init": {
  "document": "fixtures/protocol/docs/bound-mixed.json",
  "clock": 1760000000000,
  "epoch": 0,
  "principals": [
   {
    "id": "arkin",
    "author": {
     "kind": "human",
     "name": "arkin"
    },
    "role": "owner"
   },
   {
    "id": "editor",
    "author": {
     "kind": "agent",
     "name": "editor"
    },
    "role": "editor"
   },
   {
    "id": "viewer",
    "author": {
     "kind": "human",
     "name": "viewer"
    },
    "role": "viewer"
   },
   {
    "id": "host",
    "author": {
     "kind": "engine",
     "name": "host",
     "version": "0"
    },
    "role": "host"
   }
  ],
  "data": {
   "feeds": [
    {
     "feed": {
      "symbol": "THYAO",
      "interval": "1d"
     },
     "synthetic": {
      "n": 200,
      "seed": 11
     }
    },
    {
     "feed": {
      "symbol": "ASELS",
      "interval": "1d"
     },
     "synthetic": {
      "n": 60,
      "seed": 3
     }
    }
   ],
   "entitlements": {
    "host": [
     "*"
    ],
    "arkin": [
     "THYAO",
     "ASELS"
    ]
   },
   "pending": [
    {
     "symbol": "ASELS",
     "interval": "1d"
    }
   ]
  }
 },
 "steps": [
  {
   "send": {
    "conn": "a",
    "msg": {
     "type": "hello",
     "protocol": "qp/0",
     "principal": "arkin",
     "surface": {
      "kind": "headless"
     }
    }
   },
   "expect": [
    {
     "conn": "a",
     "msg": {
      "type": "welcome"
     }
    }
   ],
   "note": "RP2 T4 audit fixes (§18.3, §18.4). arkin is entitled to THYAO; editor and viewer are not."
  },
  {
   "send": {
    "conn": "e",
    "msg": {
     "type": "hello",
     "protocol": "qp/0",
     "principal": "editor",
     "surface": {
      "kind": "headless"
     }
    }
   },
   "expect": [
    {
     "conn": "e",
     "msg": {
      "type": "welcome"
     }
    }
   ]
  },
  {
   "send": {
    "conn": "v",
    "msg": {
     "type": "hello",
     "protocol": "qp/0",
     "principal": "viewer",
     "surface": {
      "kind": "headless"
     }
    }
   },
   "expect": [
    {
     "conn": "v",
     "msg": {
      "type": "welcome"
     }
    }
   ]
  },
  {
   "note": "A fact on the inline series: no data entitlement needed.",
   "send": {
    "conn": "e",
    "msg": {
     "type": "command",
     "id": "c1",
     "ops": [
      {
       "op": "add_fact",
       "id": "fx",
       "kind": "note",
       "series": "idx",
       "bar": 0,
       "text": "x",
       "evidence": {}
      }
     ]
    }
   },
   "expect": [
    {
     "conn": "e",
     "msg": {
      "type": "ack",
      "id": "c1",
      "status": "applied",
      "seq": 2
     }
    }
   ]
  },
  {
   "note": "Y1: a condition on bound data would tell its values through its outcome (the capsule's state). Writing it needs the writer's data entitlement: no_entitlement at the condition's series.",
   "send": {
    "conn": "e",
    "msg": {
     "type": "command",
     "id": "c2",
     "ops": [
      {
       "op": "add_finding",
       "claim": "probe",
       "facts": [
        "fx"
       ],
       "confidence": 0.5,
       "invalidation": {
        "kind": "threshold",
        "series": "px",
        "op": "gt",
        "value": 90.0
       },
       "capsule": "p"
      }
     ]
    }
   },
   "expect": [
    {
     "conn": "e",
     "msg": {
      "type": "error",
      "id": "c2",
      "error": {
       "code": "no_entitlement",
       "path": "/ops/0/invalidation/series"
      }
     }
    }
   ]
  },
  {
   "note": "Through a study on the bound series: an intent trigger.",
   "send": {
    "conn": "e",
    "msg": {
     "type": "command",
     "id": "c3",
     "ops": [
      {
       "op": "add_intent",
       "text": "t",
       "trigger": {
        "kind": "threshold",
        "series": "rsi14",
        "op": "gt",
        "value": 70.0
       }
      }
     ]
    }
   },
   "expect": [
    {
     "conn": "e",
     "msg": {
      "type": "error",
      "id": "c3",
      "error": {
       "code": "no_entitlement",
       "path": "/ops/0/trigger/series"
      }
     }
    }
   ]
  },
  {
   "note": "A condition subscription is checked as its subscriber.",
   "send": {
    "conn": "v",
    "msg": {
     "type": "subscribe",
     "id": "s1",
     "topic": {
      "kind": "condition",
      "condition": {
       "kind": "threshold",
       "series": "px",
       "op": "gt",
       "value": 1.0
      }
     }
    }
   },
   "expect": [
    {
     "conn": "v",
     "msg": {
      "type": "error",
      "id": "s1",
      "error": {
       "code": "no_entitlement",
       "path": "/topic/condition/series"
      }
     }
    }
   ]
  },
  {
   "send": {
    "conn": "a",
    "msg": {
     "type": "subscribe",
     "id": "s2",
     "topic": {
      "kind": "condition",
      "condition": {
       "kind": "threshold",
       "series": "px",
       "op": "gt",
       "value": 1.0
      }
     }
    }
   },
   "expect": [
    {
     "conn": "a",
     "msg": {
      "type": "ack",
      "id": "s2"
     }
    }
   ]
  },
  {
   "note": "Y2: the authority's anchor stamp (entry 1) cannot be undone; an anchor is reset only by rewriting the binding.",
   "send": {
    "conn": "a",
    "msg": {
     "type": "command",
     "id": "u1",
     "ops": [
      {
       "op": "undo",
       "seq": 1
      }
     ]
    }
   },
   "expect": [
    {
     "conn": "a",
     "msg": {
      "type": "error",
      "id": "u1",
      "error": {
       "code": "undo_conflict"
      }
     }
    }
   ]
  },
  {
   "note": "O2: the owner binds px3; the authority anchors it in engine entry 4.",
   "send": {
    "conn": "a",
    "msg": {
     "type": "command",
     "id": "c4",
     "ops": [
      {
       "op": "put_series",
       "series": {
        "id": "px3",
        "source": {
         "kind": "bind",
         "symbol": "THYAO",
         "interval": "1d",
         "window": {
          "last": 50
         }
        }
       }
      }
     ]
    }
   },
   "expect": [
    {
     "conn": "a",
     "msg": {
      "type": "ack",
      "id": "c4",
      "status": "applied",
      "seq": 3
     }
    }
   ]
  },
  {
   "note": "Undoing one's own put_series is not blocked by its anchor stamp: the series goes, the stamp with it.",
   "send": {
    "conn": "a",
    "msg": {
     "type": "command",
     "id": "u2",
     "ops": [
      {
       "op": "undo"
      }
     ]
    }
   },
   "expect": [
    {
     "conn": "a",
     "msg": {
      "type": "ack",
      "id": "u2",
      "status": "applied",
      "seq": 5,
      "undoes": 3
     }
    }
   ]
  },
  {
   "note": "O1: a seq gap is not applied; the binding is stale and the host gets a notice ({\"host\":{\"gap\":…}} over qp serve; not a connection's output).",
   "data": {
    "feed": {
     "symbol": "THYAO",
     "interval": "1d"
    },
    "seq": 9,
    "change": {
     "kind": "patch",
     "t": 1759881600000,
     "fields": {
      "v": 1.0
     }
    }
   },
   "expect": []
  },
  {
   "send": {
    "conn": "a",
    "msg": {
     "type": "query",
     "id": "q-b",
     "query": {
      "kind": "binding",
      "series": "px"
     }
    }
   },
   "expect": [
    {
     "conn": "a",
     "msg": {
      "type": "result",
      "id": "q-b",
      "data": {
       "kind": "bindings",
       "bindings": [
        {
         "series": "px",
         "state": "stale",
         "anchor_t": 1745452800000,
         "reason": "$any"
        }
       ]
      }
     }
    }
   ]
  }
 ],
 "final": {
  "document": {
   "series": [
    {
     "id": "px"
    },
    "$any",
    "$any",
    "$any"
   ]
  },
  "log_len": 5
 }
}
