{
 "name": "24-grammar-screen-hit",
 "description": "R2 semantic reading from the scene description: screen with panel names, scales and layers (data, fields, constants with origins, item counts), and the point query hit (one item, empty area, outside the panels).",
 "covers": [
  "query",
  "screen",
  "hit",
  "grammar",
  "origin"
 ],
 "init": "fixtures/protocol/init/thyao.json",
 "steps": [
  {
   "send": {
    "conn": "a",
    "msg": {
     "type": "hello",
     "protocol": "qp/0",
     "principal": "arkin",
     "surface": {
      "kind": "desktop"
     }
    }
   },
   "expect": [
    {
     "conn": "a",
     "msg": {
      "type": "welcome",
      "protocol": "qp/0",
      "principal": "arkin",
      "role": "owner",
      "seq": "$any"
     }
    }
   ]
  },
  {
   "send": {
    "conn": "a",
    "msg": {
     "type": "command",
     "id": "c1",
     "ops": [
      {
       "op": "set_panel",
       "view": "main",
       "panel": 0,
       "name": "price"
      }
     ]
    }
   },
   "expect": [
    {
     "conn": "a",
     "msg": {
      "type": "ack",
      "id": "c1",
      "status": "applied",
      "seq": 1
     }
    }
   ]
  },
  {
   "send": {
    "conn": "a",
    "msg": {
     "type": "query",
     "id": "q1",
     "query": {
      "kind": "screen"
     }
    }
   },
   "expect": [
    {
     "conn": "a",
     "msg": {
      "type": "result",
      "id": "q1",
      "data": {
       "kind": "screen",
       "screens": [
        {
         "principal": "arkin",
         "surface": "desktop",
         "viewport": {
          "view": "main",
          "from_bar": 80,
          "to_bar": 199
         },
         "symbol": "THYAO",
         "interval": "1d",
         "panels": [
          {
           "panel": 0,
           "name": "price",
           "series": [
            "px",
            "bb20"
           ],
           "marks": [
            "candle",
            "line"
           ],
           "scale": {
            "id": "y0",
            "kind": "linear",
            "domain": "$any"
           },
           "layers": [
            {
             "id": "l0",
             "mark": "candle",
             "data": {
              "kind": "series",
              "series": "px"
             },
             "items": 120,
             "constants": "$absent"
            },
            {
             "id": "l1",
             "mark": "line",
             "data": {
              "kind": "series",
              "series": "bb20"
             },
             "fields": [
              "upper",
              "middle",
              "lower"
             ],
             "constants": "$absent"
            }
           ]
          },
          {
           "panel": 1,
           "name": "$absent",
           "series": [
            "rsi14"
           ],
           "marks": [
            "line",
            "rule"
           ],
           "scale": {
            "id": "y1",
            "kind": "linear",
            "domain": [
             0,
             100
            ]
           },
           "layers": [
            {
             "id": "l2",
             "mark": "line",
             "data": {
              "kind": "series",
              "series": "rsi14"
             },
             "fields": [
              "rsi"
             ],
             "label": "RSI14",
             "items": 120
            },
            {
             "id": "l3",
             "mark": "rule",
             "data": {
              "kind": "constant"
             },
             "constants": {
              "/encoding/y": {
               "origin": {
                "kind": "threshold",
                "name": "rsi.overbought"
               },
               "value": 70
              }
             }
            }
           ]
          },
          {
           "panel": 2,
           "series": [
            "macd"
           ],
           "marks": [
            "line"
           ],
           "scale": {
            "id": "y2",
            "kind": "linear",
            "domain": "$any"
           },
           "layers": [
            {
             "id": "l4",
             "mark": "line",
             "data": {
              "kind": "series",
              "series": "macd"
             },
             "fields": [
              "macd",
              "signal"
             ],
             "label": "MACD(12,26,9)"
            }
           ]
          }
         ],
         "last_close": 124.69
        }
       ]
      }
     }
    }
   ],
   "note": "Desktop default viewport: last 120 bars (80..199). Panel 1 has a fixed domain [0,100]; bollinger draws upper/middle/lower, macd draws macd/signal (GRAMMAR §5)."
  },
  {
   "send": {
    "conn": "a",
    "msg": {
     "type": "query",
     "id": "q2",
     "query": {
      "kind": "hit",
      "view": "main",
      "x": 600,
      "y": 389
     }
    }
   },
   "expect": [
    {
     "conn": "a",
     "msg": {
      "type": "result",
      "id": "q2",
      "data": {
       "kind": "hit",
       "hit": {
        "view": "main",
        "panel": 1,
        "bar": 143,
        "t": 1753142400000,
        "value": "$any",
        "item": {
         "layer": "l3",
         "mark": "rule",
         "data": {
          "kind": "constant"
         },
         "bar": "$absent",
         "values": "$any",
         "constants": {
          "/encoding/y": {
           "origin": {
            "kind": "threshold",
            "name": "rsi.overbought"
           },
           "value": 70
          }
         }
        }
       }
      }
     }
    }
   ],
   "note": "1200x600: plot x 8..1128, y 34..576; panels 3:1:1 with 8 px gaps -> panel 1 is ~357.6..462.8, value 70 at y ~389.2; rule box +-3 px, painted after the RSI line. Slot = 1120/120; x 600 -> bar 80 + 63 = 143."
  },
  {
   "send": {
    "conn": "a",
    "msg": {
     "type": "query",
     "id": "q3",
     "query": {
      "kind": "hit",
      "view": "main",
      "x": 600,
      "y": 456
     }
    }
   },
   "expect": [
    {
     "conn": "a",
     "msg": {
      "type": "result",
      "id": "q3",
      "data": {
       "kind": "hit",
       "hit": {
        "view": "main",
        "panel": 1,
        "bar": 143,
        "t": 1753142400000,
        "value": "$any",
        "item": "$absent"
       }
      }
     }
    }
   ],
   "note": "Empty area of the RSI panel (value ~6): no item."
  },
  {
   "send": {
    "conn": "a",
    "msg": {
     "type": "query",
     "id": "q4",
     "query": {
      "kind": "hit",
      "view": "main",
      "x": 600,
      "y": 10
     }
    }
   },
   "expect": [
    {
     "conn": "a",
     "msg": {
      "type": "result",
      "id": "q4",
      "data": {
       "kind": "hit",
       "hit": {
        "view": "main",
        "panel": "$absent",
        "item": "$absent"
       }
      }
     }
    }
   ],
   "note": "Title row, outside every panel."
  },
  {
   "send": {
    "conn": "a",
    "msg": {
     "type": "query",
     "id": "q5",
     "query": {
      "kind": "hit",
      "view": "mian",
      "x": 600,
      "y": 389
     }
    }
   },
   "expect": [
    {
     "conn": "a",
     "msg": {
      "type": "error",
      "id": "q5",
      "error": {
       "code": "not_found",
       "did_you_mean": [
        "main"
       ]
      }
     }
    }
   ]
  }
 ],
 "final": {
  "log_len": 1
 }
}
