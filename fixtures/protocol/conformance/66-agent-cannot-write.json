  "name": "66-agent-cannot-write",
  "steps": [
    {
      "expect": [
        {
          "conn": "a",
          "msg": {
            "seq": 0,
            "type": "welcome"
          }
        }
      ],
      "note": "A person.",
      "send": {
        "conn": "a",
        "msg": {
          "principal": "arkin",
          "protocol": "qp/0",
          "surface": {
            "kind": "headless"
          },
          "type": "hello"
        }
      }
    },
    {
      "expect": [
        {
          "conn": "e",
          "msg": {
            "seq": 0,
            "type": "welcome"
          }
        }
      ],
      "note": "An agent whose role is `editor`.",
      "send": {
        "conn": "e",
        "msg": {
          "principal": "editor",
          "protocol": "qp/0",
          "surface": {
            "kind": "headless"
          },
          "type": "hello"
        }
      }
    },
    {
      "expect": [
        {
          "conn": "s",
          "msg": {
            "seq": 0,
            "type": "welcome"
          }
        }
      ],
      "note": "An agent (`proposer`).",
      "send": {
        "conn": "s",
        "msg": {
          "principal": "scout",
          "protocol": "qp/0",
          "surface": {
            "kind": "headless"
          },
          "type": "hello"
        }
      }
    },
    {
      "expect": [
        {
          "conn": "e",
          "msg": {
            "error": {
              "code": "forbidden",
              "hint": "Agents write comments (`add_comment`), watches (`add_watch`) and view proposals; facts, findings, capsules, the ledger and stories come from the engine.",
              "message": "an agent may not `add_fact`: facts, findings, series, capsules, the ledger and stories come from the engine",
              "path": "/ops/0",
              "reason": "agent_cannot_write"
            },
            "id": "w1",
            "type": "error"
          }
        }
      ],
      "note": "A fact: never from an agent.",
      "send": {
        "conn": "e",
        "msg": {
          "id": "w1",
          "mode": "direct",
          "ops": [
            {
              "bar": 10,
              "kind": "cross_above",
              "op": "add_fact",
              "series": "rsi14",
              "text": "made up"
            }
          ],
          "type": "command"
        }
      }
    },
    {
      "expect": [
        {
          "conn": "s",
          "msg": {
            "error": {
              "code": "forbidden",
              "hint": "Agents write comments (`add_comment`), watches (`add_watch`) and view proposals; facts, findings, capsules, the ledger and stories come from the engine.",
              "message": "an agent may not `add_finding`: facts, findings, series, capsules, the ledger and stories come from the engine",
              "path": "/ops/0",
              "reason": "agent_cannot_write"
            },
            "id": "w2",
            "type": "error"
          }
        }
      ],
      "note": "A finding: not even as a proposal.",
      "send": {
        "conn": "s",
        "msg": {
          "id": "w2",
          "mode": "propose",
          "ops": [
            {
              "claim": "Momentum güçlü.",
              "confidence": 0.6,
              "facts": [
                "fact-rsi-cross70"
              ],
              "invalidation": {
                "kind": "threshold",
                "op": "cross_below",
                "series": "rsi14",
                "value": 70.0
              },
              "op": "add_finding"
            }
          ],
          "type": "command"
        }
      }
    },
    {
      "expect": [
        {
          "conn": "e",
          "msg": {
            "error": {
              "code": "forbidden",
              "hint": "Agents write comments (`add_comment`), watches (`add_watch`) and view proposals; facts, findings, capsules, the ledger and stories come from the engine.",
              "message": "an agent may not `put_series`: facts, findings, series, capsules, the ledger and stories come from the engine",
              "path": "/ops/0",
              "reason": "agent_cannot_write"
            },
            "id": "w3",
            "type": "error"
          }
        }
      ],
      "note": "A series, from any source.",
      "send": {
        "conn": "e",
        "msg": {
          "id": "w3",
          "ops": [
            {
              "op": "put_series",
              "series": {
                "id": "s2",
                "source": {
                  "inputs": [
                    "px"
                  ],
                  "kind": "study",
                  "params": {
                    "period": 3
                  },
                  "study": "ema"
                }
              }
            }
          ],
          "type": "command"
        }
      }
    },
    {
      "expect": [
        {
          "conn": "e",
          "msg": {
            "error": {
              "code": "forbidden",
              "hint": "Agents write comments (`add_comment`), watches (`add_watch`) and view proposals; facts, findings, capsules, the ledger and stories come from the engine.",
              "message": "an agent may not `undo`: facts, findings, series, capsules, the ledger and stories come from the engine",
              "path": "/ops/0",
              "reason": "agent_cannot_write"
            },
            "id": "w4",
            "type": "error"
          }
        }
      ],
      "note": "Undo.",
      "send": {
        "conn": "e",
        "msg": {
          "id": "w4",
          "ops": [
            {
              "op": "undo"
            }
          ],
          "type": "command"
        }
      }
    },
    {
      "expect": [
        {
          "conn": "e",
          "msg": {
            "error": {
              "code": "forbidden",
              "hint": "Send it with mode auto or propose; a person accepts or rejects it.",
              "message": "an agent may `set_view_range` only as a proposal",
              "path": "/ops/0",
              "reason": "proposal_only"
            },
            "id": "v1",
            "type": "error"
          }
        }
      ],
      "note": "A view op sent `direct`: `proposal_only`.",
      "send": {
        "conn": "e",
        "msg": {
          "id": "v1",
          "mode": "direct",
          "ops": [
            {
              "from_bar": 150,
              "op": "set_view_range",
              "to_bar": 199,
              "view": "main"
            }
          ],
          "type": "command"
        }
      }
    },
    {
      "expect": [
        {
          "conn": "e",
          "msg": {
            "id": "v2",
            "proposal": "prop-1",
            "seq": 1,
            "status": "proposed",
            "type": "ack"
          }
        }
      ],
      "note": "The same with `auto`: a proposal, even for an editor.",
      "send": {
        "conn": "e",
        "msg": {
          "id": "v2",
          "ops": [
            {
              "from_bar": 150,
              "op": "set_view_range",
              "to_bar": 199,
              "view": "main"
            }
          ],
          "type": "command"
        }
      }
    },
    {
      "expect": [
        {
          "conn": "a",
          "msg": {
            "id": "p1",
            "seq": 2,
            "status": "applied",
            "type": "ack"
          }
        }
      ],
      "note": "A person writes as before.",
      "send": {
        "conn": "a",
        "msg": {
          "id": "p1",
          "ops": [
            {
              "confidence": 0.7,
              "finding": "fnd-overbought",
              "op": "update_finding"
            }
          ],
          "type": "command"
        }
      }
    }
