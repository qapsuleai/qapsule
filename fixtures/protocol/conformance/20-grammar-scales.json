{
 "name": "20-grammar-scales",
 "description": "R2 set_scale: y0 to log (seen in screen), fixed domain then auto_domain, x domain as the persistent range; invalid kinds and unknown scale ids.",
 "covers": [
  "command",
  "query",
  "screen",
  "grammar",
  "set_scale",
  "error"
 ],
 "init": "fixtures/protocol/init/thyao.json",
 "steps": [
  {
   "send": {
    "conn": "a",
    "msg": {
     "type": "hello",
     "protocol": "qp/0",
     "principal": "arkin",
     "surface": {
      "kind": "desktop"
     }
    }
   },
   "expect": [
    {
     "conn": "a",
     "msg": {
      "type": "welcome",
      "protocol": "qp/0",
      "principal": "arkin",
      "role": "owner",
      "seq": "$any"
     }
    }
   ]
  },
  {
   "send": {
    "conn": "a",
    "msg": {
     "type": "command",
     "id": "c1",
     "ops": [
      {
       "op": "set_scale",
       "view": "main",
       "scale": "y0",
       "kind": "log"
      }
     ]
    }
   },
   "expect": [
    {
     "conn": "a",
     "msg": {
      "type": "ack",
      "id": "c1",
      "status": "applied",
      "seq": 1
     }
    }
   ]
  },
  {
   "send": {
    "conn": "a",
    "msg": {
     "type": "query",
     "id": "q1",
     "query": {
      "kind": "screen"
     }
    }
   },
   "expect": [
    {
     "conn": "a",
     "msg": {
      "type": "result",
      "id": "q1",
      "data": {
       "kind": "screen",
       "screens": [
        {
         "principal": "arkin",
         "surface": "desktop",
         "panels": [
          {
           "panel": 0,
           "scale": {
            "id": "y0",
            "kind": "log",
            "domain": "$any"
           },
           "layers": "$any",
           "series": "$any",
           "marks": "$any"
          },
          {
           "panel": 1,
           "scale": {
            "id": "y1",
            "kind": "linear",
            "domain": [
             0,
             100
            ]
           },
           "layers": "$any",
           "series": "$any",
           "marks": "$any"
          },
          {
           "panel": 2,
           "scale": {
            "id": "y2",
            "kind": "linear",
            "domain": "$any"
           },
           "layers": "$any",
           "series": "$any",
           "marks": "$any"
          }
         ]
        }
       ]
      }
     }
    }
   ],
   "note": "screen reports each panel's scale id, kind and visible domain; a fixed domain is drawn as is."
  },
  {
   "send": {
    "conn": "a",
    "msg": {
     "type": "command",
     "id": "c2",
     "ops": [
      {
       "op": "set_scale",
       "view": "main",
       "scale": "y0",
       "domain": [
        90,
        135
       ]
      }
     ]
    }
   },
   "expect": [
    {
     "conn": "a",
     "msg": {
      "type": "ack",
      "id": "c2",
      "status": "applied",
      "seq": 2
     }
    }
   ]
  },
  {
   "send": {
    "conn": "a",
    "msg": {
     "type": "query",
     "id": "q2",
     "query": {
      "kind": "get",
      "id": "main"
     }
    }
   },
   "expect": [
    {
     "conn": "a",
     "msg": {
      "type": "result",
      "id": "q2",
      "data": {
       "kind": "item",
       "collection": "views",
       "item": {
        "id": "main",
        "panels": [
         {
          "id": 0,
          "y": {
           "kind": "log",
           "domain": [
            90,
            135
           ]
          }
         },
         {
          "id": 1
         },
         {
          "id": 2
         }
        ]
       }
      }
     }
    }
   ]
  },
  {
   "send": {
    "conn": "a",
    "msg": {
     "type": "command",
     "id": "c3",
     "ops": [
      {
       "op": "set_scale",
       "view": "main",
       "scale": "y0",
       "auto_domain": true
      }
     ]
    }
   },
   "expect": [
    {
     "conn": "a",
     "msg": {
      "type": "ack",
      "id": "c3",
      "status": "applied",
      "seq": 3
     }
    }
   ]
  },
  {
   "send": {
    "conn": "a",
    "msg": {
     "type": "query",
     "id": "q3",
     "query": {
      "kind": "get",
      "id": "main"
     }
    }
   },
   "expect": [
    {
     "conn": "a",
     "msg": {
      "type": "result",
      "id": "q3",
      "data": {
       "kind": "item",
       "collection": "views",
       "item": {
        "id": "main",
        "panels": [
         {
          "id": 0,
          "y": {
           "kind": "log",
           "domain": "$absent"
          }
         },
         {
          "id": 1
         },
         {
          "id": 2
         }
        ]
       }
      }
     }
    }
   ]
  },
  {
   "send": {
    "conn": "a",
    "msg": {
     "type": "command",
     "id": "c4",
     "ops": [
      {
       "op": "set_scale",
       "view": "main",
       "scale": "x",
       "domain": [
        1750291200000,
        1759881600000
       ]
      }
     ]
    }
   },
   "expect": [
    {
     "conn": "a",
     "msg": {
      "type": "ack",
      "id": "c4",
      "status": "applied",
      "seq": 4
     }
    }
   ],
   "note": "set_scale x changes the persistent range (G6), like set_view_range."
  },
  {
   "send": {
    "conn": "a",
    "msg": {
     "type": "command",
     "id": "c5",
     "ops": [
      {
       "op": "set_scale",
       "view": "main",
       "scale": "y1",
       "kind": "time"
      }
     ]
    }
   },
   "expect": [
    {
     "conn": "a",
     "msg": {
      "type": "error",
      "id": "c5",
      "error": {
       "code": "invalid",
       "path": "/ops/0/kind"
      }
     }
    }
   ],
   "note": "time is the horizontal axis only."
  },
  {
   "send": {
    "conn": "a",
    "msg": {
     "type": "command",
     "id": "c6",
     "ops": [
      {
       "op": "set_scale",
       "view": "main",
       "scale": "x",
       "kind": "log"
      }
     ]
    }
   },
   "expect": [
    {
     "conn": "a",
     "msg": {
      "type": "error",
      "id": "c6",
      "error": {
       "code": "invalid",
       "path": "/ops/0/kind"
      }
     }
    }
   ],
   "note": "the time axis stays time."
  },
  {
   "send": {
    "conn": "a",
    "msg": {
     "type": "command",
     "id": "c7",
     "ops": [
      {
       "op": "set_scale",
       "view": "main",
       "scale": "y9",
       "kind": "log"
      }
     ]
    }
   },
   "expect": [
    {
     "conn": "a",
     "msg": {
      "type": "error",
      "id": "c7",
      "error": {
       "code": "not_found",
       "path": "/ops/0/scale"
      }
     }
    }
   ]
  },
  {
   "send_raw": {
    "conn": "a",
    "line": "{\"type\": \"command\", \"id\": \"c8\", \"ops\": [{\"op\": \"set_scale\", \"view\": \"main\", \"scale\": \"y0\", \"kind\": \"logarithmic\"}]}"
   },
   "expect": [
    {
     "conn": "a",
     "msg": {
      "type": "error",
      "id": "c8",
      "error": {
       "code": "schema"
      }
     }
    }
   ],
   "note": "unknown scale kind is a schema error."
  }
 ],
 "final": {
  "log_len": 4,
  "document": {
   "views": [
    {
     "id": "main",
     "x": {
      "kind": "time",
      "domain": [
       1750291200000,
       1759881600000
      ]
     },
     "panels": [
      {
       "id": 0,
       "y": {
        "kind": "log",
        "domain": "$absent"
       }
      },
      {
       "id": 1,
       "y": {
        "kind": "linear",
        "domain": [
         0,
         100
        ]
       }
      },
      {
       "id": 2,
       "y": {
        "kind": "linear"
       }
      }
     ]
    }
   ]
  }
 }
}
