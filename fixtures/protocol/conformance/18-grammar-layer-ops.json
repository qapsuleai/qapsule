       },
       "label": "$absent"
      },
      {
       "id": "l3",
       "mark": "rule",
       "panel": 1,
       "encoding": {
        "color": "#9e9e9e",
        "y": "70"
       },
       "origin": {
        "/encoding/y": {
         "kind": "threshold",
         "name": "rsi.overbought"
        }
       },
       "label": "$absent"
      },
      {
       "id": "l4",
       "mark": "line",
       "series": "macd",
