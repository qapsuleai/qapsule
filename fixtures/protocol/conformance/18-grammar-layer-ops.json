       }
      }
     ],
     "layers": [
      {
       "id": "l0",
       "mark": "candle",
       "series": "px",
       "panel": 0,
       "label": "$absent"
      },
      {
       "id": "l1",
       "mark": "line",
       "series": "bb20",
       "panel": 0,
       "encoding": {
        "color": "#90a4ae"
       },
       "label": "$absent"
      },
      {
       "id": "l2",
       "mark": "line",
       "series": "rsi14",
       "panel": 1,
       "encoding": {
        "color": "#7e57c2",
