{
 "name": "19-grammar-panels",
 "description": "R2 panel operations by id: insert_panel with a layer (ack.created panel id then layer id), move_panel, set_panel, delete_panel cascade and its undo; the last panel cannot be deleted.",
 "covers": [
  "command",
  "change",
  "grammar",
  "insert_panel",
  "move_panel",
  "set_panel",
  "delete_panel",
  "error"
 ],
 "init": "fixtures/protocol/init/thyao.json",
 "steps": [
  {
   "send": {
    "conn": "a",
    "msg": {
     "type": "hello",
     "protocol": "qp/0",
     "principal": "arkin",
     "surface": {
      "kind": "desktop"
     }
    }
   },
   "expect": [
    {
     "conn": "a",
     "msg": {
      "type": "welcome",
      "protocol": "qp/0",
      "principal": "arkin",
      "role": "owner",
      "seq": "$any"
     }
    }
   ]
  },
  {
   "send": {
    "conn": "w",
    "msg": {
     "type": "hello",
     "protocol": "qp/0",
     "principal": "viewer",
     "surface": {
      "kind": "headless"
     }
    }
   },
   "expect": [
    {
     "conn": "w",
     "msg": {
      "type": "welcome",
      "protocol": "qp/0",
      "principal": "viewer",
      "role": "viewer",
      "seq": "$any"
     }
    }
   ]
  },
  {
   "send": {
    "conn": "w",
    "msg": {
     "type": "subscribe",
     "id": "s1",
     "topic": {
      "kind": "changes"
     }
    }
   },
   "expect": [
    {
     "conn": "w",
     "msg": {
      "type": "ack",
      "id": "s1",
      "status": "subscribed"
     }
    }
   ]
  },
  {
   "send": {
    "conn": "a",
    "msg": {
     "type": "command",
     "id": "c1",
     "ops": [
      {
       "op": "insert_panel",
       "view": "main",
       "after": 0,
       "panel": {
        "name": "vol",
        "y": {
         "kind": "linear"
        }
       },
       "layers": [
        {
         "mark": "bar",
         "series": "px",
         "encoding": {
          "y": "v"
         }
        }
       ]
      }
     ]
    }
   },
   "expect": [
    {
     "conn": "a",
     "msg": {
      "type": "ack",
      "id": "c1",
      "status": "applied",
      "seq": 1,
      "created": [
       "3",
       "l5"
      ]
     }
    },
    {
     "conn": "w",
     "msg": {
      "type": "notify",
      "sub": "s1",
      "event": {
       "kind": "change",
       "seq": 1,
       "author": "arkin",
       "cause": "c1",
       "changes": [
        {
         "op": "put_panel",
         "view": "main",
         "index": 1,
         "panel": {
          "id": 3,
          "name": "vol",
          "y": {
           "kind": "linear"
          }
         }
        },
        {
         "op": "insert_layer",
         "view": "main",
         "index": 5,
         "layer": {
          "id": "l5",
          "mark": "bar",
          "series": "px",
          "panel": 3,
          "encoding": {
           "y": "v"
          }
         }
        }
       ]
      }
     }
    }
   ],
   "note": "Panel id = largest + 1 = 3 (GRAMMAR §2); ack.created = panel id (decimal) then layer ids (§5.1)."
  },
  {
   "send": {
    "conn": "a",
    "msg": {
     "type": "command",
     "id": "c2",
     "ops": [
      {
       "op": "move_panel",
       "view": "main",
       "panel": 3,
       "after": 2
      }
     ]
    }
   },
   "expect": [
    {
     "conn": "a",
     "msg": {
      "type": "ack",
      "id": "c2",
      "status": "applied",
      "seq": 2
     }
    },
    {
     "conn": "w",
     "msg": {
      "type": "notify",
      "sub": "s1",
      "event": {
       "kind": "change",
       "seq": 2,
       "author": "arkin",
       "cause": "c2",
       "changes": [
        {
         "op": "put_panel",
         "view": "main",
         "index": 3,
         "panel": {
          "id": 3,
          "name": "vol"
         }
        }
       ]
      }
     }
    }
   ]
  },
  {
   "send": {
    "conn": "a",
    "msg": {
     "type": "command",
     "id": "c3",
     "ops": [
      {
       "op": "set_panel",
       "view": "main",
       "panel": 1,
       "name": "rsi",
       "weight": 2
      }
     ]
    }
   },
   "expect": [
    {
     "conn": "a",
     "msg": {
      "type": "ack",
      "id": "c3",
      "status": "applied",
      "seq": 3
     }
    },
    {
     "conn": "w",
     "msg": {
      "type": "notify",
      "sub": "s1",
      "event": {
       "kind": "change",
       "seq": 3,
       "author": "arkin",
       "cause": "c3",
       "changes": [
        {
         "op": "put_panel",
         "view": "main",
         "index": 1,
         "panel": {
          "id": 1,
          "name": "rsi",
          "weight": 2,
          "y": {
           "kind": "linear",
           "domain": [
            0,
            100
           ]
          }
         }
        }
       ]
      }
     }
    }
   ]
  },
  {
   "send": {
    "conn": "a",
    "msg": {
     "type": "command",
     "id": "c4",
     "ops": [
      {
       "op": "delete_panel",
       "view": "main",
       "panel": 2
      }
     ]
    }
   },
   "expect": [
    {
     "conn": "a",
     "msg": {
      "type": "ack",
      "id": "c4",
      "status": "applied",
      "seq": 4
     }
    },
    {
     "conn": "w",
     "msg": {
      "type": "notify",
      "sub": "s1",
      "event": {
       "kind": "change",
       "seq": 4,
       "author": "arkin",
       "cause": "c4",
       "changes": [
        {
         "op": "delete_layer",
         "view": "main",
         "index": 4,
         "layer": "l4"
        },
        {
         "op": "delete_panel",
         "view": "main",
         "panel": 2
        }
       ]
      }
     }
    }
   ],
   "note": "Cascade: the panel's layers are deleted first (delete_layer), then delete_panel."
  },
  {
   "send": {
    "conn": "a",
    "msg": {
     "type": "query",
     "id": "q1",
     "query": {
      "kind": "get",
      "id": "main"
     }
    }
   },
   "expect": [
    {
     "conn": "a",
     "msg": {
      "type": "result",
      "id": "q1",
      "data": {
       "kind": "item",
       "collection": "views",
       "item": {
        "id": "main",
        "panels": [
         {
          "id": 0
         },
         {
          "id": 1,
          "name": "rsi",
          "weight": 2
         },
         {
          "id": 3,
          "name": "vol"
         }
        ],
        "layers": [
         {
          "id": "l0"
         },
         {
          "id": "l1"
         },
         {
          "id": "l2"
         },
         {
          "id": "l3"
         },
         {
          "id": "l5",
          "panel": 3
         }
        ]
       }
      }
     }
    }
   ]
  },
  {
   "send": {
    "conn": "a",
    "msg": {
     "type": "command",
     "id": "c5",
     "ops": [
      {
       "op": "delete_panel",
       "view": "main",
       "panel": 0
      },
      {
       "op": "delete_panel",
       "view": "main",
       "panel": 1
      },
      {
       "op": "delete_panel",
       "view": "main",
       "panel": 3
      }
     ]
    }
   },
   "expect": [
    {
     "conn": "a",
     "msg": {
      "type": "error",
      "id": "c5",
      "error": {
       "code": "invalid",
       "path": "/ops/2/panel"
      }
     }
    }
   ],
   "note": "A view keeps at least one panel: the third op fails, so none is applied."
  },
  {
   "send": {
    "conn": "a",
    "msg": {
     "type": "command",
     "id": "c6",
     "ops": [
      {
       "op": "move_panel",
       "view": "main",
       "panel": 3,
       "after": 9
      }
     ]
    }
   },
   "expect": [
    {
     "conn": "a",
     "msg": {
      "type": "error",
      "id": "c6",
      "error": {
       "code": "not_found",
       "path": "/ops/0/after"
      }
     }
    }
   ]
  },
  {
   "send": {
    "conn": "a",
    "msg": {
     "type": "command",
     "id": "c7",
     "ops": [
      {
       "op": "set_panel",
       "view": "main",
       "panel": 1,
       "weight": 0
      }
     ]
    }
   },
   "expect": [
    {
     "conn": "a",
     "msg": {
      "type": "error",
      "id": "c7",
      "error": {
       "code": "invalid",
       "path": "/ops/0/weight"
      }
     }
    }
   ],
   "note": "weight must be > 0 (GRAMMAR §2)."
  },
  {
   "send": {
    "conn": "a",
    "msg": {
     "type": "command",
     "id": "u4",
     "ops": [
      {
       "op": "undo"
      }
     ]
    }
   },
   "expect": [
    {
     "conn": "a",
     "msg": {
      "type": "ack",
      "id": "u4",
      "status": "applied",
      "seq": 5,
      "undoes": 4
     }
    },
    {
     "conn": "w",
     "msg": {
      "type": "notify",
      "sub": "s1",
      "event": {
       "kind": "change",
       "seq": 5,
       "author": "arkin",
       "cause": "u4",
       "changes": "$any"
      }
     }
    }
   ],
   "note": "Undo of delete_panel restores the panel and its layer in place."
  }
 ],
 "final": {
  "log_len": 5,
  "document": {
   "views": [
    {
     "id": "main",
     "panels": [
      {
       "id": 0
      },
      {
       "id": 1,
       "name": "rsi",
       "weight": 2
      },
      {
       "id": 2
      },
      {
       "id": 3,
       "name": "vol"
      }
     ],
     "layers": [
      {
       "id": "l0"
      },
      {
       "id": "l1"
      },
      {
       "id": "l2"
      },
      {
       "id": "l3"
      },
      {
       "id": "l4",
       "panel": 2
      },
      {
       "id": "l5",
       "panel": 3
      }
     ]
    }
   ]
  }
 }
}
