#!/usr/bin/env node
// RD2/G — the comparison rig (GOAL §2, P14; rounds/RD2/experiments/gallery/README.md).
//
//   scripts/design-gallery [--looks a,b,c] [--anchors c1,c2,c3,c4] [--real [SYMBOL]]
//                          [--fixture FILE --view ID] [--out DIR] [--no-build]
//
// For every look × theme (dark, light) × anchor: renders the core chart(s) with
// `qp render --look --theme --scale <dpr>` from one fixture (same data everywhere), writes
// the look's generated variables (`qp look css`) and fonts, screenshots the anchor
// mockup with Playwright at its exact CSS size and DPR (desktop 2, phone 3), and writes
// index.html (the gallery), compare.html (one page: rows = anchors, columns = looks +
// `oltan` + the reference screenshot from ../refs) and layout-<look>.json (P9 input).
//
// Mockup per look: docs/design/mockups/<look>/cN.html when it exists (a direction's
// copy), docs/design/mockups/_base/cN.html otherwise. Phone anchors use `<look>-tel`
// when that look is registered (two-profile directions, tokens contract).
//
// Output (default rounds/RD2/experiments/gallery/out/) is git-ignored. --real uses local
// bars from fixtures/local/bars (never commit anything it produces). Reference images
// are read in place from ../refs, never copied.
'use strict';

const fs = require('node:fs');
const path = require('node:path');
const { execFileSync } = require('node:child_process');
const { pathToFileURL } = require('node:url');
const { createRequire } = require('node:module');

const ROOT = path.resolve(__dirname, '..');
const MAIN = path.dirname(
  execFileSync('git', ['rev-parse', '--path-format=absolute', '--git-common-dir'], { cwd: ROOT })
    .toString()
    .trim()
);
const REFS = process.env.QP_REFS || path.resolve(MAIN, '..', 'refs');
const TARGET = process.env.CARGO_TARGET_DIR || path.join(MAIN, 'target');
const QP = path.join(TARGET, 'debug', 'qp');

const THEMES = [
  ['dark', 'koyu'],
  ['light', 'açık'],
];
const ANCHORS = {
  c1: { title: 'Ç1 masaüstü çalışma alanı', w: 1440, h: 900, dpr: 2, phone: false },
  c2: { title: 'Ç2 grafik hücresi yakın', w: 960, h: 600, dpr: 2, phone: false },
  c3: { title: 'Ç3 telefon kontrol kulesi', w: 390, h: 844, dpr: 3, phone: true },
  c4: { title: 'Ç4 telefon grafik ve açılmış kapsül', w: 390, h: 844, dpr: 3, phone: true },
};
// docs/design/ADOPTED.md "Galeri başvuru ekranları": read in place, never copied.
const REFERENCE = {
  c1: ['src/longsurf-ai__openchart/docs/assets/dashboard-preview.png', 'OpenChart, 3836×2102 px (≈ DPR 2,66)'],
  c2: ['src/longsurf-ai__openchart/docs/assets/charts-ui/01-single-chart.png', 'OpenChart, 2560×1680 px (DPR 2)'],
  c3: [
    'src/Hitheshkaranth__OpenTerminalUI/assets/readme/research-mobile.png',
    'OpenTerminalUI, 390×844 (DPR 1); kısmi: içerik yoğunluğu için, biçim için değil',
  ],
  c4: [
    'src/Hitheshkaranth__OpenTerminalUI/output/playwright/wave2-data-quality-mobile.png',
    'OpenTerminalUI, 390×844 (DPR 1); kısmi: içerik yoğunluğu için, biçim için değil',
  ],
};

function parseArgs(argv) {
  const a = { looks: ['oltan', 'r4'], anchors: Object.keys(ANCHORS), real: null, build: true };
  a.out = path.join(ROOT, 'rounds/RD2/experiments/gallery/out');
  for (let i = 0; i < argv.length; i++) {
    const k = argv[i];
    const next = () => {
      if (i + 1 >= argv.length) die(`${k} needs a value`);
      return argv[++i];
    };
    if (k === '--looks') a.looks = next().split(',').filter(Boolean);
    else if (k === '--anchors') a.anchors = next().split(',').filter(Boolean);
    else if (k === '--out') a.out = path.resolve(next());
    else if (k === '--fixture') a.fixture = path.resolve(next());
    else if (k === '--view') a.view = next();
    else if (k === '--no-build') a.build = false;
    else if (k === '--real') a.real = argv[i + 1] && !argv[i + 1].startsWith('--') ? next() : '';
    else if (k === '-h' || k === '--help') {
      process.stdout.write(fs.readFileSync(__filename, 'utf8').split('\n').slice(1, 21).join('\n') + '\n');
      process.exit(0);
    } else die(`unknown option ${k}`);
  }
  // P14: R5's `oltan` always stands in the same rig.
  if (!a.looks.includes('oltan')) a.looks.push('oltan');
  for (const n of a.anchors) if (!ANCHORS[n]) die(`unknown anchor ${n}`);
  return a;
}

function die(msg) {
  process.stderr.write(`design-gallery: ${msg}\n`);
  process.exit(2);
}

function qp(args) {
  return execFileSync(QP, args, { cwd: ROOT, maxBuffer: 64 << 20 }).toString();
}

function loadPlaywright() {
  for (const dir of [ROOT, MAIN]) {
    try {
      return createRequire(path.join(dir, 'shells/web/package.json'))('playwright');
    } catch {
      /* next */
    }
  }
  return die('playwright not found (cd shells/web && npm ci)');
}

// ---- data: one fixture for every look (same data, P14) ----

function findDesignFixture() {
  const dir = path.join(ROOT, 'fixtures/design');
  if (!fs.existsSync(dir)) return null;
  for (const f of fs.readdirSync(dir).sort()) {
    if (!f.endsWith('.json')) continue;
    const text = fs.readFileSync(path.join(dir, f), 'utf8');
    if (/"id"\s*:\s*"desk"/.test(text)) return { file: path.join(dir, f), view: 'desk' };
  }
  return null;
}

function pickFixture(a) {
  if (a.fixture) return { file: a.fixture, view: a.view || die('--fixture needs --view') };
  return (
    findDesignFixture() || { file: path.join(ROOT, 'fixtures/views/v1-three-panels.json'), view: 'three' }
  );
}

function fixtureKind(file) {
  const j = JSON.parse(fs.readFileSync(file, 'utf8'));
  return Array.isArray(j.steps) ? '--transcript' : '--init';
}

// --real: the fixture's first embedded bar series replaced by the last bars of a local
// series (fixtures/local/bars/<SYM>.1day.adj.json). Written under the ignored out dir.
function realFixture(fx, symbol, out) {
  const barsDir = path.join(MAIN, 'fixtures/local/bars');
  if (!fs.existsSync(barsDir)) die('--real: fixtures/local/bars is missing');
  const files = fs.readdirSync(barsDir).filter((f) => f.endsWith('.1day.adj.json')).sort();
  const pick = symbol ? files.find((f) => f.startsWith(`${symbol}.`)) : files[0];
  if (!pick) die(`--real: no daily bars for ${symbol || 'any symbol'}`);
  const real = JSON.parse(fs.readFileSync(path.join(barsDir, pick), 'utf8'));
  const src = JSON.parse(fs.readFileSync(fx.file, 'utf8'));
  const init = src.init || src;
  if (typeof init.document !== 'string') die('--real: the fixture init has no document path');
  const doc = JSON.parse(fs.readFileSync(path.join(ROOT, init.document), 'utf8'));
  const series = doc.series.find((s) => s.data && Array.isArray(s.data.bars));
  if (!series) die('--real: the fixture document has no embedded bars');
  const n = series.data.bars.length;
  series.data.bars = real.data.bars.slice(-n);
  if (series.instrument) series.instrument.symbol = real.instrument.symbol;
  const dir = path.join(out, 'real-src');
  fs.mkdirSync(dir, { recursive: true });
  const docPath = path.join(dir, 'doc.json');
  fs.writeFileSync(docPath, JSON.stringify(doc));
  init.document = path.relative(ROOT, docPath);
  const file = path.join(dir, path.basename(fx.file));
  fs.writeFileSync(file, JSON.stringify(src));
  return { file, view: fx.view, real: real.instrument.symbol };
}

// ---- looks: generated variables and fonts ----

function writeVars(look, theme, varsDir) {
  const body = qp(['look', 'css', look, '--theme', theme]);
  const head = `/* generated by scripts/design-gallery from \`qp look css ${look} --theme ${theme}\`; do not edit */\n`;
  fs.writeFileSync(path.join(varsDir, `${look}-${theme}.css`), `${head}:root {\n${body}}\n`);
}

// Every font file of the look under each CSS family of its published family, by weight,
// so `font-weight: 600` on the body family picks the real semibold file.
function writeFonts(look, varsDir) {
  const fonts = JSON.parse(qp(['look', 'show', look])).fonts || [];
  const fontsDir = path.join(ROOT, 'crates/qp-render/assets/fonts');
  const faces = [];
  for (const f of fonts) {
    for (const g of fonts.filter((x) => x.family === f.family)) {
      const url = pathToFileURL(path.join(fontsDir, g.file)).href;
      const style = g.italic ? 'italic' : 'normal';
      faces.push(
        `@font-face { font-family: "${f.css_family}"; src: url("${url}"); font-weight: ${g.weight}; font-style: ${style}; }`
      );
    }
  }
  const head = `/* generated by scripts/design-gallery from \`qp look show ${look}\` fonts; do not edit */\n`;
  fs.writeFileSync(path.join(varsDir, `fonts-${look}.css`), head + [...new Set(faces)].join('\n') + '\n');
}

// ---- screenshots ----

function mockupFile(look, anchor) {
  const own = path.join(ROOT, 'docs/design/mockups', look, `${anchor}.html`);
  return fs.existsSync(own) ? own : path.join(ROOT, 'docs/design/mockups/_base', `${anchor}.html`);
}

function pageUrl(file, q) {
  return `${pathToFileURL(file).href}?${new URLSearchParams(q)}`;
}

async function settle(page) {
  await page.waitForFunction(() => document.documentElement.dataset.ready === '1', null, { timeout: 20000 });
  await page.evaluate(() => document.fonts.ready);
}

async function shoot(browser, job) {
  const { anchor, spec, look, theme, fx, out } = job;
  const ctx = await browser.newContext({
    viewport: { width: spec.w, height: spec.h },
    deviceScaleFactor: spec.dpr,
    colorScheme: theme,
  });
  const page = await ctx.newPage();
  const errors = [];
  page.on('pageerror', (e) => errors.push(String(e)));
  const chartsRel = `charts/${look}-${theme}/`;
  const q = {
    look,
    theme,
    vars: pathToFileURL(path.join(out, 'vars')).href + '/',
    charts: pathToFileURL(path.join(out, chartsRel)).href,
    dpr: String(spec.dpr),
  };
  const url = pageUrl(mockupFile(job.mockLook, anchor), q);
  await page.goto(url);
  await settle(page);
  // The layout decides the chart size: measure every slot, render it at that size × DPR.
  const slots = await page.$$eval('img[data-chart]', (imgs) =>
    imgs.map((i) => {
      const r = i.parentElement.getBoundingClientRect();
      return { name: i.dataset.chart, w: Math.round(r.width), h: Math.round(r.height) };
    })
  );
  fs.mkdirSync(path.join(out, chartsRel), { recursive: true });
  for (const s of slots) {
    if (s.w < 1 || s.h < 1) continue;
    qp([
      'render', fx.kind, path.relative(ROOT, fx.file), '--view', fx.view, '--look', look,
      '--theme', theme, '--scale', String(spec.dpr), '--width', String(s.w), '--height', String(s.h),
      '-o', path.join(out, chartsRel, `${s.name}.png`),
    ]);
  }
  await page.goto(url);
  await settle(page);
  const shot = `shots/${anchor}-${look}-${theme}.png`;
  await page.screenshot({ path: path.join(out, shot) });
  let regions = null;
  if (anchor === 'c1') regions = await page.$$eval('[data-region]', (els) => els.length);
  await ctx.close();
  return { shot, url, slots, regions, errors };
}

// P9 input for design-check: regions of the Ç1 layout, chart panes and legend numbers of
// its core chart (numeric tokens of texts inside the panes: not axis labels).
function layoutDump(look, fx, slot, regions) {
  const scene = JSON.parse(
    qp([
      'scene', fx.kind, path.relative(ROOT, fx.file), '--view', fx.view, '--look', look,
      '--width', String(slot.w), '--height', String(slot.h), '--roles',
    ])
  );
  const right = Math.max(...scene.panels.map((p) => p.rect.right));
  const bottom = Math.max(...scene.panels.map((p) => p.rect.bottom));
  let numbers = 0;
  for (const p of [...(scene.under || []), ...(scene.over || [])]) {
    if (p.prim !== 'text' || p.x >= right || p.baseline > bottom) continue;
    numbers += p.text.split(/\s+/).filter((t) => /^[-+−]?\d[\d.,]*%?$/.test(t)).length;
  }
  return { regions, chart_panes: scene.panels.length, legend_numbers: numbers };
}

// ---- pages ----

const esc = (s) => String(s).replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]);
const themeWord = (t) => THEMES.find(([k]) => k === t)[1];
const label = (r) => `${r.look}, ${themeWord(r.theme)}, ${r.spec.w}×${r.spec.h} CSS, DPR ${r.spec.dpr}`;

// The gallery's own chrome is neutral and outside the comparison; it never tints images.
const PAGE_CSS = `
body { margin: 0; padding: 24px; font: 14px/1.4 system-ui, sans-serif; background: Canvas; color: CanvasText; }
h1 { font-size: 20px; margin: 0 0 4px; } h2 { font-size: 16px; margin: 32px 0 8px; }
p.lead { margin: 0 0 16px; max-width: 80ch; color: GrayText; }
.row { display: grid; gap: 16px; align-items: start; }
figure { margin: 0; } figcaption { font-size: 12px; margin-bottom: 4px; }
figure img { width: 100%; height: auto; display: block; outline: 1px solid GrayText; }
figure.missing div { padding: 24px; outline: 1px dashed GrayText; color: GrayText; }
a { color: LinkText; }`;

function figure(src, cap, href) {
  const img = `<img src="${esc(src)}" alt="${esc(cap)}" loading="lazy">`;
  return `<figure><figcaption>${esc(cap)}</figcaption>${href ? `<a href="${esc(href)}">${img}</a>` : img}</figure>`;
}

function refFigure(anchor) {
  const [rel, note] = REFERENCE[anchor];
  const file = path.join(REFS, rel);
  const cap = `Başvuru: ${note}`;
  if (!fs.existsSync(file)) return `<figure class="missing"><figcaption>${esc(cap)}</figcaption><div>Yok: ${esc(file)}</div></figure>`;
  return figure(pathToFileURL(file).href, cap, pathToFileURL(file).href);
}

function writePages(a, results, fx) {
  const data = fx.real
    ? `Veri: yerel gerçek (${fx.real}); bu görseller commit edilmez.`
    : `Veri: sentetik, ${path.relative(ROOT, fx.file)} görünüm "${fx.view}".`;
  const rule = 'Aynı veri, aynı boyut; masaüstü DPR 2, telefon DPR 3; başvuru ekranı yanda. Etiket görselin üstünde.';
  const cols = a.looks.length + 1;
  let cmp = `<!doctype html><html lang="tr"><meta charset="utf-8"><title>RD2 karşılaştırma</title><style>${PAGE_CSS}
.row { grid-template-columns: repeat(${cols}, minmax(0, 1fr)); }</style>
<h1>RD2 karşılaştırma</h1><p class="lead">${esc(rule)} ${esc(data)} Görünüşler: ${esc(a.looks.join(', '))}.</p>`;
  for (const anchor of a.anchors) {
    for (const [theme] of THEMES) {
      cmp += `<h2>${esc(ANCHORS[anchor].title)}, ${themeWord(theme)}</h2><div class="row">`;
      for (const look of a.looks) {
        const r = results.find((x) => x.anchor === anchor && x.baseLook === look && x.theme === theme);
        cmp += r ? figure(r.shot, label(r), r.shot) : '<figure class="missing"><div>Yok</div></figure>';
      }
      cmp += `${refFigure(anchor)}</div>`;
    }
  }
  fs.writeFileSync(path.join(a.out, 'compare.html'), cmp + '</html>\n');

  let idx = `<!doctype html><html lang="tr"><meta charset="utf-8"><title>RD2 galeri</title><style>${PAGE_CSS}
.row { grid-template-columns: repeat(2, minmax(0, 1fr)); }</style>
<h1>RD2 galeri</h1><p class="lead">${esc(rule)} ${esc(data)} Her görselin bağlantısı canlı maketi açar.
Tek sayfalık karşılaştırma: <a href="compare.html">compare.html</a>.</p>`;
  for (const look of a.looks) {
    idx += `<h2>${esc(look)}</h2>`;
    for (const anchor of a.anchors) {
      idx += `<div class="row">`;
      for (const [theme] of THEMES) {
        const r = results.find((x) => x.anchor === anchor && x.baseLook === look && x.theme === theme);
        if (r) idx += figure(r.shot, `${ANCHORS[anchor].title}: ${label(r)}`, r.url);
      }
      idx += `</div>`;
    }
  }
  fs.writeFileSync(path.join(a.out, 'index.html'), idx + '</html>\n');
}

// ---- main ----

async function main() {
  const a = parseArgs(process.argv.slice(2));
  if (a.build) execFileSync('cargo', ['build', '-q', '-p', 'qp-cli'], { cwd: ROOT, stdio: 'inherit' });
  const known = qp(['look', 'list']).split('\n').map((l) => l.split('\t')[0]).filter(Boolean);
  for (const l of a.looks) if (!known.includes(l)) die(`unknown look ${l} (qp look list: ${known.join(', ')})`);

  fs.rmSync(a.out, { recursive: true, force: true });
  for (const d of ['vars', 'shots', 'charts']) fs.mkdirSync(path.join(a.out, d), { recursive: true });
  let fx = pickFixture(a);
  if (a.real !== null) fx = realFixture(fx, a.real, a.out);
  fx.kind = fixtureKind(fx.file);

  const { chromium } = loadPlaywright();
  const browser = await chromium.launch({ args: ['--force-color-profile=srgb', '--font-render-hinting=none'] });
  const results = [];
  try {
    for (const baseLook of a.looks) {
      const phoneLook = known.includes(`${baseLook}-tel`) ? `${baseLook}-tel` : baseLook;
      for (const l of new Set([baseLook, phoneLook])) {
        writeFonts(l, path.join(a.out, 'vars'));
        for (const [theme] of THEMES) writeVars(l, theme, path.join(a.out, 'vars'));
      }
      for (const anchor of a.anchors) {
        const spec = ANCHORS[anchor];
        const look = spec.phone ? phoneLook : baseLook;
        for (const [theme] of THEMES) {
          const r = await shoot(browser, { anchor, spec, look, mockLook: baseLook, theme, fx, out: a.out });
          for (const e of r.errors) process.stderr.write(`design-gallery: ${anchor} ${look} ${theme}: ${e}\n`);
          results.push({ ...r, anchor, spec, look, baseLook, theme });
          process.stdout.write(`  ${r.shot}\n`);
        }
      }
      const c1 = results.find((r) => r.anchor === 'c1' && r.baseLook === baseLook);
      if (c1) {
        const dump = layoutDump(baseLook, fx, c1.slots[0], c1.regions);
        fs.writeFileSync(path.join(a.out, `layout-${baseLook}.json`), JSON.stringify(dump) + '\n');
      }
    }
  } finally {
    await browser.close();
  }
  writePages(a, results, fx);
  fs.writeFileSync(
    path.join(a.out, 'manifest.json'),
    JSON.stringify({ fixture: path.relative(ROOT, fx.file), view: fx.view, real: fx.real || null, looks: a.looks,
      shots: results.map((r) => ({ anchor: r.anchor, look: r.look, theme: r.theme, file: r.shot,
        css: [r.spec.w, r.spec.h], dpr: r.spec.dpr })) }, null, 1) + '\n'
  );
  process.stdout.write(`gallery: ${path.join(a.out, 'index.html')}\ncompare: ${path.join(a.out, 'compare.html')}\n`);
}

main().catch((e) => die(e.stack || String(e)));
