     },
     "panels": [
      {
       "id": 0,
       "y": {
        "kind": "linear"
       }
      },
      {
       "id": 1,
       "y": {
        "kind": "linear"
       }
      }
     ],
     "layers": [
      {
       "mark": "candle",
       "series": "px",
       "panel": 0
      },
      {
       "mark": "line",
       "series": "rsi14",
       "panel": 1
      },
      {
       "mark": "rule",
       "panel": 1,
       "origin": {
        "/encoding/y": {
         "kind": "fact",
         "fact": "fact-rsi-cross70",
         "field": "level"
        }
       }
      }
     ],
     "emphasis": [
      {
       "kind": "highlight",
       "target": "$any"
      }
     ],
     "id": "fv"
    }
   ],
   "capsules": [
