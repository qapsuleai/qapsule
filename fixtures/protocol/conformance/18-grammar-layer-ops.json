{
 "name": "18-grammar-layer-ops",
 "description": "R2 grammar layer operations by id (insert_layer after/before, move_layer to another panel, set_encoding + unset, delete_layer), their change events, and undo of each restoring the document.",
 "covers": [
  "command",
  "change",
  "grammar",
  "insert_layer",
  "move_layer",
  "set_encoding",
  "delete_layer",
  "undo"
 ],
 "init": "fixtures/protocol/init/thyao.json",
 "steps": [
  {
   "send": {
    "conn": "a",
    "msg": {
     "type": "hello",
     "protocol": "qp/0",
     "principal": "arkin",
     "surface": {
      "kind": "desktop"
     }
    }
   },
   "expect": [
    {
     "conn": "a",
     "msg": {
      "type": "welcome",
      "protocol": "qp/0",
      "principal": "arkin",
      "role": "owner",
      "seq": "$any"
     }
    }
   ]
  },
  {
   "send": {
    "conn": "w",
    "msg": {
     "type": "hello",
     "protocol": "qp/0",
     "principal": "viewer",
     "surface": {
      "kind": "headless"
     }
    }
   },
   "expect": [
    {
     "conn": "w",
     "msg": {
      "type": "welcome",
      "protocol": "qp/0",
      "principal": "viewer",
      "role": "viewer",
      "seq": "$any"
     }
    }
   ]
  },
  {
   "send": {
    "conn": "w",
    "msg": {
     "type": "subscribe",
     "id": "s1",
     "topic": {
      "kind": "changes"
     }
    }
   },
   "expect": [
    {
     "conn": "w",
     "msg": {
      "type": "ack",
      "id": "s1",
      "status": "subscribed"
     }
    }
   ]
  },
  {
   "send": {
    "conn": "a",
    "msg": {
     "type": "command",
     "id": "c1",
     "ops": [
      {
       "op": "insert_layer",
       "view": "main",
       "after": "l0",
       "layer": {
        "id": "close",
        "mark": "line",
        "series": "px",
        "panel": 0,
        "encoding": {
         "y": "c"
        }
       }
      }
     ]
    }
   },
   "expect": [
    {
     "conn": "a",
     "msg": {
      "type": "ack",
      "id": "c1",
      "status": "applied",
      "seq": 1,
      "created": [
       "close"
      ]
     }
    },
    {
     "conn": "w",
     "msg": {
      "type": "notify",
      "sub": "s1",
      "event": {
       "kind": "change",
       "seq": 1,
       "author": "arkin",
       "cause": "c1",
       "changes": [
        {
         "op": "insert_layer",
         "view": "main",
         "index": 1,
         "layer": {
          "id": "close",
          "mark": "line",
          "series": "px",
          "panel": 0,
          "encoding": {
           "y": "c"
          }
         }
        }
       ]
      }
     }
    }
   ],
   "note": "insert_layer after l0: the change carries the position the authority computed (§5.1, §5.3)."
  },
  {
   "send": {
    "conn": "a",
    "msg": {
     "type": "command",
     "id": "c2",
     "ops": [
      {
       "op": "insert_layer",
       "view": "main",
       "before": "l3",
       "layer": {
        "mark": "line",
        "series": "bb20",
        "panel": 1,
        "encoding": {
         "y": "upper"
        }
       }
      }
     ]
    }
   },
   "expect": [
    {
     "conn": "a",
     "msg": {
      "type": "ack",
      "id": "c2",
      "status": "applied",
      "seq": 2,
      "created": [
       "l5"
      ]
     }
    },
    {
     "conn": "w",
     "msg": {
      "type": "notify",
      "sub": "s1",
      "event": {
       "kind": "change",
       "seq": 2,
       "author": "arkin",
       "cause": "c2",
       "changes": [
        {
         "op": "insert_layer",
         "view": "main",
         "index": 4,
         "layer": {
          "id": "l5",
          "mark": "line",
          "series": "bb20",
          "panel": 1
         }
        }
       ]
      }
     }
    }
   ],
   "note": "No id given: smallest unused l<k> (GRAMMAR §4) = l5; before l3 -> index 4."
  },
  {
   "send": {
    "conn": "a",
    "msg": {
     "type": "command",
     "id": "c3",
     "ops": [
      {
       "op": "move_layer",
       "view": "main",
       "layer": "l5",
       "panel": 2,
       "after": "l4"
      }
     ]
    }
   },
   "expect": [
    {
     "conn": "a",
     "msg": {
      "type": "ack",
      "id": "c3",
      "status": "applied",
      "seq": 3
     }
    },
    {
     "conn": "w",
     "msg": {
      "type": "notify",
      "sub": "s1",
      "event": {
       "kind": "change",
       "seq": 3,
       "author": "arkin",
       "cause": "c3",
       "changes": [
        {
         "op": "put_layer",
         "view": "main",
         "index": 6,
         "layer": {
          "id": "l5",
          "mark": "line",
          "series": "bb20",
          "panel": 2,
          "encoding": {
           "y": "upper"
          }
         }
        }
       ]
      }
     }
    }
   ],
   "note": "move_layer -> put_layer with the final position (after l4 = last of 7)."
  },
  {
   "send": {
    "conn": "a",
    "msg": {
     "type": "command",
     "id": "c4",
     "ops": [
      {
       "op": "set_encoding",
       "view": "main",
       "layer": "close",
       "encoding": {
        "color": "down",
        "width": 2
       }
      }
     ]
    }
   },
   "expect": [
    {
     "conn": "a",
     "msg": {
      "type": "ack",
      "id": "c4",
      "status": "applied",
      "seq": 4
     }
    },
    {
     "conn": "w",
     "msg": {
      "type": "notify",
      "sub": "s1",
      "event": {
       "kind": "change",
       "seq": 4,
       "author": "arkin",
       "cause": "c4",
       "changes": [
        {
         "op": "put_layer",
         "view": "main",
         "index": 1,
         "layer": {
          "id": "close",
          "encoding": {
           "y": "c",
           "color": "down",
           "width": 2
          }
         }
        }
       ]
      }
     }
    }
   ],
   "note": "set_encoding: given channels change, others (y) stay."
  },
  {
   "send": {
    "conn": "a",
    "msg": {
     "type": "command",
     "id": "c5",
     "ops": [
      {
       "op": "set_encoding",
       "view": "main",
       "layer": "close",
       "unset": [
        "color"
       ],
       "label": "Close"
      }
     ]
    }
   },
   "expect": [
    {
     "conn": "a",
     "msg": {
      "type": "ack",
      "id": "c5",
      "status": "applied",
      "seq": 5
     }
    },
    {
     "conn": "w",
     "msg": {
      "type": "notify",
      "sub": "s1",
      "event": {
       "kind": "change",
       "seq": 5,
       "author": "arkin",
       "cause": "c5",
       "changes": [
        {
         "op": "put_layer",
         "view": "main",
         "index": 1,
         "layer": {
          "id": "close",
          "label": "Close",
          "encoding": {
           "y": "c",
           "width": 2,
           "color": "$absent"
          }
         }
        }
       ]
      }
     }
    }
   ],
   "note": "unset removes a channel; label replaced."
  },
  {
   "send": {
    "conn": "a",
    "msg": {
     "type": "command",
     "id": "c6",
     "ops": [
      {
       "op": "delete_layer",
       "view": "main",
       "layer": "close"
      }
     ]
    }
   },
   "expect": [
    {
     "conn": "a",
     "msg": {
      "type": "ack",
      "id": "c6",
      "status": "applied",
      "seq": 6
     }
    },
    {
     "conn": "w",
     "msg": {
      "type": "notify",
      "sub": "s1",
      "event": {
       "kind": "change",
       "seq": 6,
       "author": "arkin",
       "cause": "c6",
       "changes": [
        {
         "op": "delete_layer",
         "view": "main",
         "index": 1,
         "layer": "close"
        }
       ]
      }
     }
    }
   ],
   "note": "delete_layer change carries the index and the layer id (R2)."
  },
  {
   "send": {
    "conn": "a",
    "msg": {
     "type": "query",
     "id": "q1",
     "query": {
      "kind": "get",
      "id": "main"
     }
    }
   },
   "expect": [
    {
     "conn": "a",
     "msg": {
      "type": "result",
      "id": "q1",
      "data": {
       "kind": "item",
       "collection": "views",
       "item": {
        "id": "main",
        "layers": [
         {
          "id": "l0",
          "mark": "candle",
          "series": "px",
          "panel": 0,
          "label": "$absent"
         },
         {
          "id": "l1",
          "mark": "line",
          "series": "bb20",
          "panel": 0,
          "encoding": {
           "color": "#90a4ae"
          },
          "label": "$absent"
         },
         {
          "id": "l2",
          "mark": "line",
          "series": "rsi14",
          "panel": 1,
          "encoding": {
           "color": "#7e57c2",
           "y": "rsi"
          },
          "label": "$absent"
         },
         {
          "id": "l3",
          "mark": "rule",
          "panel": 1,
          "encoding": {
           "color": "#9e9e9e",
           "y": "70"
          },
          "origin": {
           "/encoding/y": {
            "kind": "threshold",
            "name": "rsi.overbought"
           }
          },
          "label": "$absent"
         },
         {
          "id": "l4",
          "mark": "line",
          "series": "macd",
          "panel": 2,
          "label": "$absent"
         },
         {
          "id": "l5",
          "panel": 2
         }
        ]
       }
      }
     }
    }
   ]
  },
  {
   "send": {
    "conn": "a",
    "msg": {
     "type": "command",
     "id": "u6",
     "ops": [
      {
       "op": "undo"
      }
     ]
    }
   },
   "expect": [
    {
     "conn": "a",
     "msg": {
      "type": "ack",
      "id": "u6",
      "status": "applied",
      "seq": 7,
      "undoes": 6
     }
    },
    {
     "conn": "w",
     "msg": {
      "type": "notify",
      "sub": "s1",
      "event": {
       "kind": "change",
       "seq": 7,
       "author": "arkin",
       "cause": "u6",
       "changes": "$any"
      }
     }
    }
   ]
  },
  {
   "send": {
    "conn": "a",
    "msg": {
     "type": "query",
     "id": "q2",
     "query": {
      "kind": "get",
      "id": "main"
     }
    }
   },
   "expect": [
    {
     "conn": "a",
     "msg": {
      "type": "result",
      "id": "q2",
      "data": {
       "kind": "item",
       "collection": "views",
       "item": {
        "id": "main",
        "layers": [
         {
          "id": "l0",
          "mark": "candle",
          "series": "px",
          "panel": 0,
          "label": "$absent"
         },
         {
          "id": "close",
          "label": "Close",
          "encoding": {
           "y": "c",
           "width": 2,
           "color": "$absent"
          }
         },
         {
          "id": "l1",
          "mark": "line",
          "series": "bb20",
          "panel": 0,
          "encoding": {
           "color": "#90a4ae"
          },
          "label": "$absent"
         },
         {
          "id": "l2",
          "mark": "line",
          "series": "rsi14",
          "panel": 1,
          "encoding": {
           "color": "#7e57c2",
           "y": "rsi"
          },
          "label": "$absent"
         },
         {
          "id": "l3",
          "mark": "rule",
          "panel": 1,
          "encoding": {
           "color": "#9e9e9e",
           "y": "70"
          },
          "origin": {
           "/encoding/y": {
            "kind": "threshold",
            "name": "rsi.overbought"
           }
          },
          "label": "$absent"
         },
         {
          "id": "l4",
          "mark": "line",
          "series": "macd",
          "panel": 2,
          "label": "$absent"
         },
         {
          "id": "l5"
         }
        ]
       }
      }
     }
    }
   ],
   "note": "undo of delete_layer puts the layer back at its old index"
  },
  {
   "send": {
    "conn": "a",
    "msg": {
     "type": "command",
     "id": "u5",
     "ops": [
      {
       "op": "undo"
      }
     ]
    }
   },
   "expect": [
    {
     "conn": "a",
     "msg": {
      "type": "ack",
      "id": "u5",
      "status": "applied",
      "seq": 8,
      "undoes": 5
     }
    },
    {
     "conn": "w",
     "msg": {
      "type": "notify",
      "sub": "s1",
      "event": {
       "kind": "change",
       "seq": 8,
       "author": "arkin",
       "cause": "u5",
       "changes": "$any"
      }
     }
    }
   ]
  },
  {
   "send": {
    "conn": "a",
    "msg": {
     "type": "command",
     "id": "u4",
     "ops": [
      {
       "op": "undo"
      }
     ]
    }
   },
   "expect": [
    {
     "conn": "a",
     "msg": {
      "type": "ack",
      "id": "u4",
      "status": "applied",
      "seq": 9,
      "undoes": 4
     }
    },
    {
     "conn": "w",
     "msg": {
      "type": "notify",
      "sub": "s1",
      "event": {
       "kind": "change",
       "seq": 9,
       "author": "arkin",
       "cause": "u4",
       "changes": "$any"
      }
     }
    }
   ]
  },
  {
   "send": {
    "conn": "a",
    "msg": {
     "type": "command",
     "id": "u3",
     "ops": [
      {
       "op": "undo"
      }
     ]
    }
   },
   "expect": [
    {
     "conn": "a",
     "msg": {
      "type": "ack",
      "id": "u3",
      "status": "applied",
      "seq": 10,
      "undoes": 3
     }
    },
    {
     "conn": "w",
     "msg": {
      "type": "notify",
      "sub": "s1",
      "event": {
       "kind": "change",
       "seq": 10,
       "author": "arkin",
       "cause": "u3",
       "changes": "$any"
      }
     }
    }
   ]
  },
  {
   "send": {
    "conn": "a",
    "msg": {
     "type": "command",
     "id": "u2",
     "ops": [
      {
       "op": "undo"
      }
     ]
    }
   },
   "expect": [
    {
     "conn": "a",
     "msg": {
      "type": "ack",
      "id": "u2",
      "status": "applied",
      "seq": 11,
      "undoes": 2
     }
    },
    {
     "conn": "w",
     "msg": {
      "type": "notify",
      "sub": "s1",
      "event": {
       "kind": "change",
       "seq": 11,
       "author": "arkin",
       "cause": "u2",
       "changes": "$any"
      }
     }
    }
   ]
  },
  {
   "send": {
    "conn": "a",
    "msg": {
     "type": "command",
     "id": "u1",
     "ops": [
      {
       "op": "undo"
      }
     ]
    }
   },
   "expect": [
    {
     "conn": "a",
     "msg": {
      "type": "ack",
      "id": "u1",
      "status": "applied",
      "seq": 12,
      "undoes": 1
     }
    },
    {
     "conn": "w",
     "msg": {
      "type": "notify",
      "sub": "s1",
      "event": {
       "kind": "change",
       "seq": 12,
       "author": "arkin",
       "cause": "u1",
       "changes": "$any"
      }
     }
    }
   ]
  }
 ],
 "final": {
  "log_len": 12,
  "document": {
   "views": [
    {
     "id": "main",
     "panels": [
      {
       "id": 0,
       "name": "$absent",
       "y": {
