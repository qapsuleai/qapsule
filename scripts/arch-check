#!/usr/bin/env python3
"""Repository architecture check (docs/ENGINEERING.md §1.3; RG1).

  scripts/arch-check                 check; exit 1 on any error
  scripts/arch-check --self-test     known violations are caught (and the ratchet works)
  scripts/arch-check --list          also print every tolerated (baseline) finding
  scripts/arch-check --json          findings as JSON (for reports)
  scripts/arch-check --table         crate line table (non-test / test lines)
  scripts/arch-check --root <dir>    measure another tree (a worktree) with this config
  scripts/arch-check --write-baseline [--allow-new]  write scripts/arch-baseline.json from
                                     the current findings; refuses any value or count above
                                     the existing baseline, and new items without --allow-new

Rules: layer.up / layer.lateral / layer.unknown (cargo metadata, normal and build
dependencies; dev-dependencies are not layered), file.hard / file.soft (src files, raw
lines; files whose first lines say "üretilmiştir" or "@generated" are exempt), test.file,
fn.lines (non-test functions), dir.files, crate.lines / shell.lines (non-test src lines),
name.forbidden, readme.crate / readme.module, root.logic (lib.rs / mod.rs hold only
module declarations and re-exports), doc.size. Hard rules never take a baseline.
Configuration: scripts/arch-config.json; baseline: scripts/arch-baseline.json (ratchet).
"""

import json
import os
import sys

HERE = os.path.dirname(os.path.abspath(__file__))
sys.path.insert(0, HERE)

from archcheck import baseline as bl  # noqa: E402
from archcheck import rules, selftest  # noqa: E402

ROOT = os.path.dirname(HERE)
CFG_PATH = os.path.join(HERE, "arch-config.json")
BASE_PATH = os.path.join(HERE, "arch-baseline.json")


def main(argv):
    if "--self-test" in argv:
        return 0 if selftest.run() else 1
    root = ROOT
    if "--root" in argv:  # measure another tree (e.g. a worktree) with this config/baseline
        root = os.path.abspath(argv[argv.index("--root") + 1])
    with open(CFG_PATH, encoding="utf-8") as fh:
        cfg = json.load(fh)
    findings, scan = rules.all_findings(root, cfg)
    if "--table" in argv:
        t = rules.crate_line_table(scan)
        print(f"{'crate':14} {'non-test':>9} {'test':>7}")
        for c, (a, z) in sorted(t.items(), key=lambda kv: -kv[1][0]):
            print(f"{c:14} {a:9} {z:7}")
        return 0
    if "--json" in argv:
        print(json.dumps(findings, ensure_ascii=False, indent=1))
        return 0
    base = bl.load(BASE_PATH)
    hard = set(cfg["hard_rules"])
    findings, excepted, unused = bl.split_exceptions(findings, cfg)
    errors, tolerated, stale = bl.judge(findings, base, hard)
    if "--write-baseline" in argv:
        # The ratchet: an existing baseline may only shrink. A first baseline (empty file)
        # or new debt needs `--allow-new <reason>` and is then a reviewed change.
        allow_new = "--allow-new" in argv
        bad = [e for e in errors if e["rule"] not in hard
               and (e.get("why", "").startswith(("above", "rule count")) or not allow_new)]
        if bad and base.get("rules") is not None and (base.get("rules") or not allow_new):
            for e in bad:
                print("refused (ratchet):", e["message"], "-", e["why"])
            return 1
        new = bl.build(findings, hard, base)
        with open(BASE_PATH, "w", encoding="utf-8") as fh:
            json.dump(new, fh, ensure_ascii=False, indent=1, sort_keys=True)
            fh.write("\n")
        print(f"baseline written: {sum(r['count'] for r in new['rules'].values())} items")
        return 0
    for o, v in sorted(cfg.get("layer_overrides", {}).items()):
        print(f"EXCEPTION layer: {o} placed in `{v['layer']}` ({v.get('status', '')}): {v.get('reason', '')}")
    for f in excepted:
        e = f["exception"]
        print(f"EXCEPTION [{f['rule']}] {f['message']} — {e.get('id', '')} {e.get('status', '')}: {e.get('reason', '')}")
    for e in unused:
        print(f"unused exception (remove it): {e['rule']} {e['item']}")
    by_rule = {}
    for f in tolerated:
        by_rule[f["rule"]] = by_rule.get(f["rule"], 0) + 1
    if "--list" in argv:
        for f in tolerated:
            print("baseline:", f["message"])
    for s in stale:
        print("stale baseline:", s)
    for e in errors:
        print(f"ERROR [{e['rule']}] {e['message']} ({e['why']})")
    summary = ", ".join(f"{r} {n}" for r, n in sorted(by_rule.items())) or "none"
    print(f"arch-check: {len(errors)} error(s); {len(excepted) + len(cfg.get('layer_overrides', {}))} "
          f"exception(s) awaiting approval; within the baseline: {summary}")
    return 1 if errors else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
