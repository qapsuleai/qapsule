  "description": "R5B (§25.3): with `init.agent_policy = \"r5b\"` an agent command follows the allow-list: facts, findings, series and undo are `agent_cannot_write` in every mode; views are proposals only (`auto` becomes a proposal even for an `editor`; `direct` is `proposal_only`); a person writes as before.",
  "final": {
    "log_len": 2
  },
  "init": {
    "agent_policy": "r5b",
    "clock": 1760000000000,
    "document": "fixtures/protocol/docs/thyao.json",
